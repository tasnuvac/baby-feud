{
  "name": "baby-feud",
  "version": "1.0.0",
  "description": "Baby Feud game",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win",
    "build:mac": "electron-builder --mac"
  },
  "build": {
    "appId": "com.babyfeud.game",
    "productName": "Baby Feud",
    "files": [
      "index.html",
      "style.css",
      "script.js", 
      "main.js",
      "assets/**/*"
    ],
    "win": {
      "target": "nsis"
    }
  },
  "devDependencies": {
    "electron": "latest",
    "electron-builder": "latest"
  }
}